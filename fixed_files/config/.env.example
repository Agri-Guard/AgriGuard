# ─────────────────────────────────────────────────────────────────────────────
# AgriGuard environment configuration — copy to config/.env and fill in values
#   cp config/.env.example config/.env
# config/.env is git-ignored; never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ────────────────────────────────────────────────────────────
APP_ENV=development          # development | production
DEBUG=true
SECRET_KEY=change-me-generate-with-python-secrets-token-hex-32
LOG_LEVEL=INFO

# ── Backend / frontend URLs (used for CORS + Streamlit -> API calls) ───────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000      # docker-compose: http://backend:8000
FRONTEND_URL=http://localhost:8501

# ── ML model & data paths ───────────────────────────────────────────────────
AGRIGUARD_PRICE_DATA=data/raw/wfp_food_prices_uga.csv
MODEL_DIR=ml/models

# ── Anthropic (optional — enables AI vision for fake-input image analysis) ──
ANTHROPIC_API_KEY=

# ── Database (optional — defaults to local SQLite if unset) ────────────────
DATABASE_URL=sqlite:///./agriguard_dev.db

# ── Africa's Talking (optional — only needed for real USSD gateway, not the
#    /ussd/simulate endpoint used for local testing) ────────────────────────
AT_API_KEY=
AT_USERNAME=
