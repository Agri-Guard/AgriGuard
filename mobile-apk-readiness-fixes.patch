diff --git a/mobile/android/app/src/main/res/xml/network_security_config.xml b/mobile/android/app/src/main/res/xml/network_security_config.xml
index af50149..47aff13 100644
--- a/mobile/android/app/src/main/res/xml/network_security_config.xml
+++ b/mobile/android/app/src/main/res/xml/network_security_config.xml
@@ -4,12 +4,20 @@
   Android 9+ (API 28+) blocks cleartext traffic by default.
   Add your specific LAN IP below instead of allowing it globally —
   keeps things safe for anything that isn't your own dev server.
+
+  NOTE: 192.168.18.8 matches the LAN IP the desktop dashboard was actually
+  running on (seen in the AgriGuard dashboard screenshots) — the previous
+  192.168.1.42 here didn't match and would have silently blocked the
+  hidden dev-override path (Settings → About, tap version 7x) on a real
+  device. DHCP can still reassign this on your router at any time — if the
+  dev override stops connecting, check `ip addr` / `ifconfig` on the
+  machine running the backend and update this to match.
 -->
 <network-security-config>
     <domain-config cleartextTrafficPermitted="true">
         <!-- Android Emulator loopback alias -->
         <domain includeSubdomains="false">10.0.2.2</domain>
-        <!-- Replace with your machine's actual LAN IP for real-device testing -->
-        <domain includeSubdomains="false">192.168.1.42</domain>
+        <!-- Keith's dev machine LAN IP — see note above -->
+        <domain includeSubdomains="false">192.168.18.8</domain>
     </domain-config>
 </network-security-config>
